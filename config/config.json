{
  "desktop": {
    "autoStart": true,
    "minimizeToTray": true,
    "notifications": true,
    "schedulerEnabled": true
  },
  "storageProfiles": {
    "prod-google-drive": {
      "type": "google_drive",
      "rootFolderName": "Tally Backup",
      "secretId": "prod-google-drive"
    }
  },
  "backup": {
    "sources": [
      {
        "name": "Tally Data",
        "enabled": true,
        "operation": "backup",
        "sourcePath": "D:\\Tally Data\\TALLY.ERP9",
        "backupFolderName": "Tally Backup",
        "storageProfile": "prod-google-drive"
      },
      {
        "name": "Data-Search",
        "enabled": true,
        "operation": "restore",
        "sourcePath": "C:\\Users\\Vinod Home\\Documents\\Customer-Data",
        "backupFolderName": "Customer-Data",
        "storageProfile": "prod-google-drive",
        "restore": {
          "mode": "manual",
          "snapshotId": "latest",
          "cleanDest": false,
          "timezone": "Asia/Kolkata"
        }
      }
    ],
    "schedule": "0 20 * * *",
    "maxRetries": 3,
    "retryDelay": 5000,
    "compressionLevel": 6,
    "chunkSizeMB": 50
  },
  "googleDrive": {
    "credentialsPath": "secret:config.google.oauth.credentials",
    "tokenPath": "secret:config.google.oauth.token",
    "maxFileSize": 104857600,
    "uploadTimeout": 300000
  },
  "deduplication": {
    "enabled": true,
    "hashAlgorithm": "SHA256",
    "blockSize": 1048576
  },
  "retention": {
    "keepDailyBackups": 30,
    "keepWeeklyBackups": 12,
    "keepMonthlyBackups": 12
  },
  "logging": {
    "level": "info",
    "maxFiles": 10,
    "maxSize": "10m"
  },
  "email": {
    "enabled": true,
    "smtp": {
      "host": "smtp.gmail.com",
      "port": 587,
      "secure": false,
      "auth": {
        "user": "vinodkhoraa@gmail.com",
        "pass": "secret:config.email.smtp.password"
      }
    },
    "from": "vinodkhoraa@gmail.com",
    "to": "vinodkhoraa@gmail.com",
    "subject": "Tally Backup Report",
    "sendOnSuccess": true,
    "sendOnFailure": true,
    "includeStats": true,
    "includeDriveLink": true
  }
}