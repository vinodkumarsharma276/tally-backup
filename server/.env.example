# Control plane: separate deployable, real secrets never committed.
NODE_ENV=development
PORT=8787

# Auth
JWT_SECRET=change-me-in-production
# Set during a key rotation; tokens signed with the old secret still verify.
JWT_SECRET_PREVIOUS=
TOKEN_TTL_SECONDS=900
LEASE_TTL_SECONDS=3600

# Data residency (compliance) — region customer data is stored in.
DATA_REGION=us-east-1

# Store: memory | sqlite | postgres
STORE=memory
SQLITE_PATH=./data/control-plane.db
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Vending provider: dev | aws-sts | b2
VENDING_PROVIDER=dev
VENDING_MASTER_SECRET=dev-master-secret

# Managed bucket (the desktop app talks S3 to this via vended creds)
MANAGED_BUCKET=tally-managed-dev
MANAGED_REGION=us-east-1
MANAGED_ENDPOINT=
MANAGED_FORCE_PATH_STYLE=false

# Optional: dev provider can pass through real static creds so the loop can run
# against a local MinIO / real S3 for end-to-end I/O testing.
DEV_S3_ACCESS_KEY_ID=
DEV_S3_SECRET_ACCESS_KEY=

# aws-sts provider (scaffold)
AWS_STS_ROLE_ARN=
AWS_REGION=us-east-1

# b2 provider (scaffold)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=

# r2 provider (Cloudflare temp access credentials)
R2_ACCOUNT_ID=
R2_API_TOKEN=
R2_PARENT_ACCESS_KEY_ID=
R2_BUCKET=

# Audit log: file | console | none
AUDIT_SINK=console
AUDIT_FILE=./data/audit.log

# Company mailer — how report emails are sent FROM your company address.
# provider: dev (offline/testing) | smtp | resend | sendgrid
MAILER_PROVIDER=dev
MAILER_FROM=Backup Genie <no-reply@backupgenie.app>
MAILER_API_KEY=
# Optional monitoring copy of every report sent (disclose in your privacy policy).
MAILER_ADMIN_BCC=

# Generic SMTP relay (MAILER_PROVIDER=smtp) — works with Brevo, Zoho ZeptoMail,
# Amazon SES, Mailjet, Resend, SendGrid... the password is usually the API key.
#   Brevo    smtp-relay.brevo.com
#   Resend   smtp.resend.com            (user: resend)
#   SendGrid smtp.sendgrid.net          (user: apikey)
#   SES      email-smtp.<region>.amazonaws.com
MAILER_SMTP_HOST=
MAILER_SMTP_PORT=587
MAILER_SMTP_SECURE=false
MAILER_SMTP_USER=
MAILER_SMTP_PASS=

# Website enquiry form (site/ -> POST /v1/contact). Leave CONTACT_INBOX empty to
# disable email notification. Origins must match the browser Origin header exactly.
CONTACT_INBOX=
CONTACT_ALLOWED_ORIGINS=https://vinodkumarsharma276.github.io,http://localhost:5173
CONTACT_MAX_PER_HOUR=5

# Durable record of every enquiry, written BEFORE the notification email so a
# mail outage cannot lose a lead: none | memory | file | firestore
CONTACT_STORE=none
CONTACT_FILE=./data/enquiries.jsonl
# firestore store
FIRESTORE_PROJECT_ID=
CONTACT_FIRESTORE_COLLECTION=enquiries
# Optional: non-default Firestore database id
FIRESTORE_DATABASE_ID=
# Auth: either point GOOGLE_APPLICATION_CREDENTIALS at a service-account file,
# or paste the service-account JSON here (for hosts with no writable disk).
FIRESTORE_CREDENTIALS_JSON=

# Billing: dev | razorpay | stripe
BILLING_PROVIDER=dev
BILLING_WEBHOOK_SECRET=dev-webhook-secret
# JSON map of provider plan/price id -> internal plan id (starter|pro|business)
# e.g. {"plan_MNO123":"pro","price_abc":"business"}
BILLING_PLAN_MAP={}

# Billing lapse handling
GRACE_RETENTION_DAYS=15
