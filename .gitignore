# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Google Drive API credentials and tokens
config/credentials.json
config/token.json
config/token_*.json
config/*token*.json

# Bundled distributable OAuth client (real values injected at build time)
config/google-oauth-client.json

# Backup data and state
data/
temp/
logs/

# Large local sample / test data — never commit (hundreds of MB, exceeds GitHub limits)
Tally Data*/

# Backup destinations created while testing. An exact-copy job pointed inside
# the repo would otherwise add every copied file to git.
SecondaryBackup/
*Backup copy/
BackupGenie-restore*/

# Desktop build output (installers, blockmaps, update feeds) — CI rebuilds and
# publishes these to GitHub Releases; never track them.
releases/desktop/
*.AppImage

# Build artifacts and distribution packages
dist/
*.exe
*.dmg
*.deb
*.rpm
# Note: releases/ folder is intentionally tracked for distribution packages
# *.tar.gz - Allow .tgz files in releases/ folder
# *.zip - Allow .zip files in releases/ folder

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Runtime files
*.pid
*.seed
*.log
