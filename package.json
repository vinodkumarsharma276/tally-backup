{
  "name": "tally-backup-pro",
  "version": "0.0.0",
  "description": "Backup Genie — automated, versioned backup solution with incremental backup, deduplication, and scheduling to Google Drive, S3, NAS, and managed cloud.",
  "main": "index.js",
  "bin": {
    "tally-backup": "./bin/tally-backup.js"
  },
  "scripts": {
    "start": "node index.js",
    "ui:dev": "vite --config vite.config.js",
    "desktop:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5172 electron desktop/main.js",
    "dev:desktop": "concurrently -k -s first \"npm:ui:dev\" \"wait-on tcp:5172 && npm run desktop:dev\"",
    "build:ui": "vite build --config vite.config.js",
    "start:desktop": "npm run build:ui && electron desktop/main.js",
    "build:desktop": "npm run build:ui && electron-builder --win nsis",
    "build:desktop:dir": "npm run build:ui && electron-builder --dir",
    "publish:desktop": "node scripts/guard-branch.js && npm run build:ui && electron-builder --win nsis --publish always",
    "backup": "node bin/manual-backup.js",
    "restore": "node bin/restore.js",
    "restore-all": "node bin/restore.js --all",
    "restore-list": "node bin/restore.js --list",
    "status": "node bin/status.js",
    "test-storage": "node tools/versioned-backup.js test-storage",
    "migrate-secrets": "node tools/migrate-secrets.js",
    "measure": "node tools/measure-chunks.js \"Tally Data\"",
    "backup-versioned": "node bin/versioned-backup.js",
    "restore-versioned": "node bin/versioned-restore.js",
    "verify-versioned": "node bin/versioned-verify.js",
    "start-versioned": "node bin/versioned-scheduler.js",
    "scheduler-versioned-jobs": "node bin/versioned-scheduler.js --list-jobs",
    "auth-test": "node tools/auth.js --config config/config_test.json",
    "setup-auth": "node setup-auth.js",
    "setup-wizard": "node setup-wizard.js",
    "setup-email": "node setup-email.js",
    "setup-sources": "node setup-sources.js",
    "install-windows-service": "node scripts/install-windows-service-pro.js",
    "install-linux-service": "node scripts/install-linux-service-pro.js",
    "uninstall-service-pro": "node scripts/uninstall-service-pro.js",
    "build-release": "node scripts/build-release.js",
    "build-package": "node scripts/build-release.js package",
    "build-obfuscated": "node scripts/build-release.js obfuscated",
    "build-npm": "node scripts/build-release.js npm",
    "package": "npm run build-release",
    "pack-npm": "npm pack",
    "pack-obfuscated": "npm run build-obfuscated",
    "publish-npm": "npm publish",
    "test": "node scripts/run-tests.js",
    "test:packed": "node test/packed.test.js",
    "test:multi-source": "node test/multi-source.test.js",
    "test:repo-marker": "node test/repo-marker.test.js",
    "postinstall": "node scripts/post-install.js"
  },
  "preferGlobal": true,
  "keywords": [
    "tally",
    "backup",
    "google-drive",
    "incremental",
    "deduplication",
    "scheduler",
    "cron",
    "enterprise",
    "windows",
    "linux",
    "cli"
  ],
  "author": {
    "name": "Vinod Sharma",
    "email": "your-email@example.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/your-username/tally-backup-pro",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/tally-backup-pro.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/tally-backup-pro/issues"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "os": [
    "win32",
    "linux",
    "darwin"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@azure/identity": "^4.13.1",
    "@azure/identity-vscode": "^2.2.0",
    "@azure/storage-blob": "^12.33.0",
    "archiver": "^7.0.1",
    "chokidar": "^4.0.3",
    "commander": "^12.1.0",
    "crypto-js": "^4.2.0",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.3",
    "googleapis": "^150.0.1",
    "inquirer": "^9.2.23",
    "keytar": "^7.9.0",
    "node-cron": "^4.1.1",
    "node-windows": "^1.0.0-beta.8",
    "nodemailer": "^9.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^40.10.6",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^4.0.2",
    "vite": "^8.1.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "in.backupgenie.app",
    "productName": "Backup Genie",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/keytar/**"
    ],
    "directories": {
      "output": "releases/desktop",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "ui/dist/**/*",
      "bin/**/*",
      "src/**/*",
      "tools/auth.js",
      "setup-auth.js",
      "config/google-oauth-client.json",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Backup-Genie-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "Backup Genie <support@backupgenie.app>",
      "synopsis": "Automated, versioned backups for your data",
      "artifactName": "Backup-Genie-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Backup Genie",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vinodkumarsharma276",
        "repo": "tally-backup",
        "releaseType": "draft"
      }
    ]
  }
}
