{
  "name": "tally-backup",
  "version": "1.0.0",
  "description": "Automated backup solution for Tally software data to Google Drive with incremental backup, deduplication, and scheduling capabilities",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "backup": "node manual-backup.js",
    "restore": "node restore.js",
    "status": "node status.js",
    "setup-auth": "node setup-auth.js",
    "setup-auth-auto": "node setup-auth-enhanced.js",
    "test": "echo \"No tests specified\" && exit 1"
  },
  "keywords": [
    "tally",
    "backup",
    "google-drive",
    "incremental",
    "deduplication",
    "scheduler",
    "cron"
  ],
