{
  "name": "tally-backup-pro",
  "version": "1.1.0",
  "description": "Professional automated backup solution for Tally software data to Google Drive with incremental backup, deduplication, and scheduling capabilities",
  "main": "index.js",
  "bin": {
    "tally-backup": "./bin/tally-backup.js"
  },
  "scripts": {
    "start": "node index.js",
    "backup": "node bin/manual-backup.js",
    "restore": "node bin/restore.js",
    "restore-all": "node bin/restore.js --all",
    "restore-list": "node bin/restore.js --list",
    "status": "node bin/status.js",
    "setup-auth": "node setup-auth.js",
    "setup-wizard": "node setup-wizard.js",
    "setup-email": "node setup-email.js",
    "setup-sources": "node setup-sources.js",
    "install-windows-service": "node scripts/install-windows-service-pro.js",
    "install-linux-service": "node scripts/install-linux-service-pro.js",
    "uninstall-service-pro": "node scripts/uninstall-service-pro.js",
    "build-release": "node scripts/build-release.js",
    "build-package": "node scripts/build-release.js package",
    "build-obfuscated": "node scripts/build-release.js obfuscated",
    "build-npm": "node scripts/build-release.js npm",
    "package": "npm run build-release",
    "pack-npm": "npm pack",
    "pack-obfuscated": "npm run build-obfuscated",
    "publish-npm": "npm publish",
    "test": "echo \"No tests specified\" && exit 1",
    "postinstall": "node scripts/post-install.js"
  },
  "preferGlobal": true,
  "keywords": [
    "tally",
    "backup",
    "google-drive",
    "incremental",
    "deduplication",
    "scheduler",
    "cron",
    "enterprise",
    "windows",
    "linux",
    "cli"
  ],
  "author": {
    "name": "Vinod Sharma",
    "email": "your-email@example.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/your-username/tally-backup-pro",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/tally-backup-pro.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/tally-backup-pro/issues"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "os": [
    "win32",
    "linux",
    "darwin"
  ],
  "dependencies": {
    "archiver": "^7.0.1",
    "chokidar": "^4.0.3",
    "commander": "^12.1.0",
    "crypto-js": "^4.2.0",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.3",
    "googleapis": "^150.0.1",
    "inquirer": "^9.2.23",
    "node-cron": "^4.1.1",
    "node-windows": "^1.0.0-beta.8",
    "nodemailer": "^6.9.15",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "javascript-obfuscator": "^4.0.2"
  }
}
