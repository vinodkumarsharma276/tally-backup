  "license": "ISC",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "chokidar": "^4.0.3",
    "crypto-js": "^4.2.0",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.3",
    "googleapis": "^150.0.1",
    "node-cron": "^4.1.1",
    "winston": "^3.17.0"
  }
}
